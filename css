* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial;
}

/* MENU BUTTON */
.menu-btn {
    position: fixed;
    top: 15px;
    right: 15px;
    font-size: 26px;
    background: white;
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
    z-index: 1000;
}

/* SIDE MENU */
.side-menu {
    position: fixed;
    top: 0;
    right: -320px;
    width: 300px;
    height: 100%;
    background: white;
    box-shadow: -5px 0 15px rgba(0,0,0,0.2);
    padding: 20px;
    transition: 0.3s;
    overflow-y: auto;
}

.side-menu.active {
    right: 0;
}

.side-menu button {
    width: 100%;
    margin-bottom: 10px;
    padding: 10px;
    border: none;
    background: #4facfe;
    color: white;
    border-radius: 8px;
    cursor: pointer;
}

/* HISTORY */
.history-item {
    background: #f1f1f1;
    padding: 8px;
    margin-bottom: 8px;
    border-radius: 6px;
    font-size: 13px;
}

/* WELCOME */
.welcome {
    height: 100vh;
    background: linear-gradient(135deg, #4facfe, #00f2fe);
    display: flex;
    justify-content: center;
    align-items: center;
}

.welcome-box {
    background: white;
    padding: 40px;
    border-radius: 15px;
    text-align: center;
}

.start-btn {
    margin-top: 15px;
    padding: 10px 20px;
    background: #4facfe;
    border: none;
    color: white;
    border-radius: 8px;
}

/* APP */
.main-app {
    display: none;
    height: 100vh;
    background: linear-gradient(135deg, #4facfe, #00f2fe);
    justify-content: center;
    align-items: center;
}

.card {
    width: 400px;
    background: white;
    border-radius: 18px;
    padding: 20px;
}

textarea {
    width: 100%;
    height: 80px;
    margin-bottom: 10px;
}

select {
    width: 100%;
    margin-bottom: 10px;
}

.btn {
    width: 100%;
    padding: 10px;
    margin-top: 5px;
    background: purple;
    color: white;
    border: none;
}

.row {
    display: flex;
    gap: 10px;
}

.small-btn {
    flex: 1;
}

.mic {
    background: red;
}

.ai-btn {
    background: green;
}
